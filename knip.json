{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    "src/worker.ts",
    "scripts/*.mjs",
    "tests/**/*.ts",
    "drizzle.*.config.ts",
    "vitest.config.ts",
    "playwright.config.ts"
  ],
  "project": ["src/**/*.{ts,tsx}", "scripts/**/*.mjs", "tests/**/*.ts"],
  "ignore": ["src/worker-configuration.d.ts", "src/infra/db/migrations/*.generated.ts"],
  "ignoreDependencies": [
    "htmx.org",
    "oxlint-tsgolint",
    "@secretlint/secretlint-rule-preset-recommend"
  ],
  "ignoreExportsUsedInFile": true
}
