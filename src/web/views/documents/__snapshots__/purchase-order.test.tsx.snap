"<!DOCTYPE html><html lang="ja"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><title>発注書 PO-2026-000123</title><style>
@page { size: A4 portrait; margin: 12mm 12mm 14mm; }
