exports[`請求書のテンプレート > A4 縦の HTML を作る（スナップショット） 1`] = `"<!DOCTYPE html><html lang="ja"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><title>請求書 INV-2026-000123</title><style></style></head><body><section class="sheet"><h1 class="doc-title">請求書</h1><table class="doc-meta"><tbody><tr><th>請求書番号</th><td>INV-2026-000123</td></tr><tr><th>発行日</th><td>2026年10月31日</td></tr><tr><th>締め期間</th><td>2026年10月1日 〜 2026年10月31日</td></tr><tr><th>お支払期限</th><td>2026年11月30日</td></tr></tbody></table><div class="doc-head"><div class="doc-to"><p class="small">〒022-0003 岩手県大船渡市盛町0-0</p><p class="name">サンプル商店 &lt;本店&gt; 御中</p></div><div class="doc-from"><p class="name">架空菓子流通株式会社</p><p>登録番号：T1234567890123</p><p>〒022-0002 岩手県大船渡市大船渡町9-9-9</p><p>TEL：0192-00-0000</p><p>billing@example.co.jp</p></div></div><p class="doc-lead">下記のとおりご請求申し上げます。</p><p class="doc-total">ご請求金額（税込） ¥1,865</p><table class="doc-table"><thead><tr><th>税率の区分</th><th>適用税率</th><th>対象額（税抜）</th><th>消費税額</th></tr></thead><tbody><tr><td>標準税率</td><td class="num">10%</td><td class="num">¥1,400</td><td class="num">¥140</td></tr><tr><td>軽減税率（※）</td><td class="num">8%</td><td class="num">¥301</td><td class="num">¥24</td></tr></tbody></table><table class="doc-table"><thead><tr><th>取引年月日</th><th>納品書・返品伝票</th><th>品名</th><th>数量</th><th>単位</th><th>単価（税抜）</th><th>金額（税抜）</th></tr></thead><tbody><tr><td>2026年10月5日</td><td class="small">DN-2026-000010</td><td>テスト銘菓 うみねこサブレ 10枚入 ※</td><td class="num">3</td><td class="center">箱</td><td class="num">¥150.50</td><td class="num">¥451</td></tr><tr><td></td><td class="small"></td><td>紙袋（大）</td><td class="num">6</td><td class="center">枚</td><td class="num">¥100</td><td class="num">¥600</td></tr><tr><td></td><td class="small"></td><td>送料</td><td class="num">1</td><td class="center"></td><td class="num">¥800</td><td class="num">¥800</td></tr><tr><td>2026年10月10日</td><td class="small">返品 RT-2026-000001</td><td>返品 テスト銘菓 うみねこサブレ 10枚入 ※</td><td class="num">-1</td><td class="center">箱</td><td class="num">¥150.50</td><td class="num">¥-150</td></tr></tbody><tfoot><tr><th colspan="5" class="num">標準税率（10%）対象</th><td class="num">¥1,400</td><td class="num">消費税 ¥140</td></tr><tr><th colspan="5" class="num">軽減税率（8%）対象</th><td class="num">¥301</td><td class="num">消費税 ¥24</td></tr><tr><th colspan="6" class="num">小計（税抜）</th><td class="num">¥1,701</td></tr><tr><th colspan="6" class="num">消費税</th><td class="num">¥164</td></tr><tr><th colspan="6" class="num">合計（税込）</th><td class="num">¥1,865</td></tr></tfoot></table><p class="small">※は軽減税率（8%）の対象です。</p><p class="small">返品は数量・金額をマイナスで記載し、ご請求金額から差し引いています。</p><p class="doc-note">お振込先：テスト銀行 本店 普通 0000000 カクウカシリュウツウ（カ</p></section></body></html>"`;

exports[`返還請求書のテンプレート > A4 縦の HTML を作る（スナップショット） 1`] = `"<!DOCTYPE html><html lang="ja"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><title>返還請求書 CN-2026-000007</title><style></style></head><body><section class="sheet"><h1 class="doc-title">返還請求書</h1><table class="doc-meta"><tbody><tr><th>返還請求書番号</th><td>CN-2026-000007</td></tr><tr><th>発行日</th><td>2026年11月2日</td></tr><tr><th>返品日</th><td>2026年10月10日</td></tr><tr><th>元の取引年月日</th><td>2026年10月5日</td></tr><tr><th>返品伝票番号</th><td>RT-2026-000001</td></tr><tr><th>納品書番号</th><td>DN-2026-000010</td></tr><tr><th>請求書番号</th><td>INV-2026-000123</td></tr></tbody></table><div class="doc-head"><div class="doc-to"><p class="small">〒022-0003 岩手県大船渡市盛町0-0</p><p class="name">サンプル商店 &lt;本店&gt; 御中</p></div><div class="doc-from"><p class="name">架空菓子流通株式会社</p><p>登録番号：T1234567890123</p><p>〒022-0002 岩手県大船渡市大船渡町9-9-9</p><p>TEL：0192-00-0000</p><p>billing@example.co.jp</p></div></div><p class="doc-lead">下記の返品について、対価を返還いたします。</p><p class="doc-total">返還額（税込） ¥162</p><table class="doc-table"><thead><tr><th>税率の区分</th><th>適用税率</th><th>対象額（税抜）</th><th>消費税額</th></tr></thead><tbody><tr><td>軽減税率（※）</td><td class="num">8%</td><td class="num">¥150</td><td class="num">¥12</td></tr></tbody></table><table class="doc-table"><thead><tr><th>商品コード</th><th>品名</th><th>数量</th><th>単位</th><th>単価（税抜）</th><th>返還額（税抜）</th></tr></thead><tbody><tr><td>IT000001</td><td>テスト銘菓 うみねこサブレ 10枚入 ※</td><td class="num">1</td><td class="center">箱</td><td class="num">¥150.50</td><td class="num">¥150</td></tr></tbody><tfoot><tr><th colspan="4" class="num">軽減税率（8%）対象</th><td class="num">¥150</td><td class="num">消費税 ¥12</td></tr><tr><th colspan="5" class="num">返還額（税込）</th><td class="num">¥162</td></tr></tfoot></table><p class="small">※は軽減税率（8%）の対象です。</p></section></body></html>"`;
