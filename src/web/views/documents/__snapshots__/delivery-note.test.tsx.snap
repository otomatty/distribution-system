exports[`納品書のテンプレート > A4 縦の HTML を作る（スナップショット） 1`] = `"<!DOCTYPE html><html lang="ja"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width, initial-scale=1"/><meta name="robots" content="noindex,nofollow"/><title>納品書 DN-2026-000123</title><style></style></head><body><section class="sheet"><h1 class="doc-title">納品書</h1><table class="doc-meta"><tbody><tr><th>納品書番号</th><td>DN-2026-000123</td></tr><tr><th>納品日</th><td>2026年11月2日</td></tr><tr><th>受注番号</th><td>SO-2026-000045</td></tr></tbody></table><div class="doc-head"><div class="doc-to"><p class="small">〒022-0003 岩手県大船渡市盛町4-5</p><p class="name">さかり商店 &lt;本店&gt; 御中</p></div><div class="doc-from"><p class="name">大船渡食品流通株式会社</p><p>登録番号：T1234567890123</p><p>〒022-0002 岩手県大船渡市大船渡町1-2-3</p><p>TEL：0192-22-0000</p></div></div><p class="small">ご担当：佐藤 様</p><p class="doc-lead">下記のとおり納品いたします。</p><p class="doc-total">合計金額（税込） ¥2,027</p><table class="doc-table"><thead><tr><th>商品コード</th><th>品名</th><th>数量</th><th>単位</th><th>単価（税抜）</th><th>金額（税抜）</th></tr></thead><tbody><tr><td>IT000001</td><td>かもめの玉子 10個入 ※</td><td class="num">3</td><td class="center">箱</td><td class="num">¥150.50</td><td class="num">¥451</td></tr><tr><td>IT000002</td><td>紙袋（大）</td><td class="num">6</td><td class="center">枚</td><td class="num">¥100</td><td class="num">¥600</td></tr><tr><td></td><td>送料</td><td class="num">1</td><td></td><td class="num">¥800</td><td class="num">¥800</td></tr></tbody><tfoot><tr><th colspan="4" class="num">標準税率（10%）対象</th><td class="num">¥1,400</td><td class="num">消費税 ¥140</td></tr><tr><th colspan="4" class="num">軽減税率（8%）対象</th><td class="num">¥451</td><td class="num">消費税 ¥36</td></tr><tr><th colspan="5" class="num">小計（税抜）</th><td class="num">¥1,851</td></tr><tr><th colspan="5" class="num">消費税</th><td class="num">¥176</td></tr><tr><th colspan="5" class="num">合計（税込）</th><td class="num">¥2,027</td></tr></tfoot></table><p class="small">※は軽減税率（8%）の対象です。</p></section></body></html>"`;
