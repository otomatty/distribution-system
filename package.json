{
  "name": "distribution-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler d1 migrations apply AUTH_DB --local && wrangler dev",
    "build:assets": "node scripts/copy-assets.mjs",
    "check": "bun run fmt:check && bun run lint && bun run typecheck && bun run test && bun run knip",
    "fmt": "oxfmt .",
    "fmt:check": "oxfmt --check .",
    "lint": "oxlint --type-aware",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tests/e2e",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test -c tests/e2e/playwright.config.ts",
    "knip": "knip",
    "db:generate": "drizzle-kit generate --config drizzle.business.config.ts && drizzle-kit generate --config drizzle.auth.config.ts && node scripts/build-migrations.mjs",
    "db:seed": "node scripts/seed.mjs",
    "cf-typegen": "wrangler types --strict-vars=false src/worker-configuration.d.ts",
    "prepare": "lefthook install || true",
    "db:migrate:local": "wrangler d1 migrations apply AUTH_DB --local"
  },
  "dependencies": {
    "better-auth": "1.7.15",
    "drizzle-orm": "0.45.4",
    "hono": "4.13.16",
    "htmx.org": "2.0.11",
    "ulid": "3.0.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.4.12",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@vitest/coverage-istanbul": "5",
    "drizzle-kit": "0.31.11",
    "fast-check": "4.10.2",
    "knip": "6.44.1",
    "lefthook": "2.2.2",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "wrangler": "4.156.1"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "bun@1.4.4"
}
