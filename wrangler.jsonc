// Cloudflare Workers の設定。本番と検証は env.production / env.staging で上書きする。
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "distribution-system",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": false,
  },
  "durable_objects": {
    "bindings": [{ "name": "BUSINESS_DB", "class_name": "BusinessDb" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BusinessDb"] }],
  "d1_databases": [
    {
      "binding": "AUTH_DB",
      "database_name": "distribution-auth-dev",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "drizzle/auth",
    },
  ],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "distribution-files-dev" }],
  "queues": {
    "producers": [{ "binding": "JOBS", "queue": "distribution-jobs-dev" }],
    "consumers": [{ "queue": "distribution-jobs-dev", "max_batch_size": 5, "max_retries": 3 }],
  },
  "triggers": {
    // 毎日 03:00（日本時間）に日次バックアップを実行する。毎時30分に止まった処理を片付ける
    "crons": ["0 18 * * *", "30 * * * *"],
  },
  "vars": {
    "ENVIRONMENT": "development",
    "APP_ORIGIN": "http://localhost:8787",
    "WORKSPACE_DOMAIN": "example.co.jp",
    "INITIAL_ADMIN_EMAIL": "admin@example.co.jp",
    "MAIL_FROM": "no-reply@example.co.jp",
  },
  "observability": { "enabled": true },
  "env": {
    "staging": {
      "vars": {
        "ENVIRONMENT": "staging",
        "APP_ORIGIN": "https://distribution-staging.example.co.jp",
        "WORKSPACE_DOMAIN": "example.co.jp",
        "INITIAL_ADMIN_EMAIL": "admin@example.co.jp",
        "MAIL_FROM": "no-reply@example.co.jp",
      },
      "durable_objects": {
        "bindings": [{ "name": "BUSINESS_DB", "class_name": "BusinessDb" }],
      },
      "d1_databases": [
        {
          "binding": "AUTH_DB",
          "database_name": "distribution-auth-staging",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "drizzle/auth",
        },
      ],
      "r2_buckets": [{ "binding": "FILES", "bucket_name": "distribution-files-staging" }],
      "queues": {
        "producers": [{ "binding": "JOBS", "queue": "distribution-jobs-staging" }],
        "consumers": [
          { "queue": "distribution-jobs-staging", "max_batch_size": 5, "max_retries": 3 },
        ],
      },
      "triggers": { "crons": ["0 18 * * *", "30 * * * *"] },
      // 帳票の PDF 化（Browser Rendering）。開発とテストでは付けず、HTML のまま保存する
      "browser": { "binding": "BROWSER" },
      // 帳票のメール送付（Cloudflare Email Service）。開発とテストでは付けず、ログに出力する
      "send_email": [{ "name": "EMAIL" }],
    },
    "production": {
      "vars": {
        "ENVIRONMENT": "production",
        "APP_ORIGIN": "https://distribution.example.co.jp",
        "WORKSPACE_DOMAIN": "example.co.jp",
        "INITIAL_ADMIN_EMAIL": "admin@example.co.jp",
        "MAIL_FROM": "no-reply@example.co.jp",
      },
      "durable_objects": {
        "bindings": [{ "name": "BUSINESS_DB", "class_name": "BusinessDb" }],
      },
      "d1_databases": [
        {
          "binding": "AUTH_DB",
          "database_name": "distribution-auth-production",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "drizzle/auth",
        },
      ],
      "r2_buckets": [{ "binding": "FILES", "bucket_name": "distribution-files-production" }],
      "queues": {
        "producers": [{ "binding": "JOBS", "queue": "distribution-jobs-production" }],
        "consumers": [
          { "queue": "distribution-jobs-production", "max_batch_size": 5, "max_retries": 3 },
        ],
      },
      "triggers": { "crons": ["0 18 * * *", "30 * * * *"] },
      // 帳票の PDF 化（Browser Rendering）。開発とテストでは付けず、HTML のまま保存する
      "browser": { "binding": "BROWSER" },
      // 帳票のメール送付（Cloudflare Email Service）。開発とテストでは付けず、ログに出力する
      "send_email": [{ "name": "EMAIL" }],
    },
  },
}
